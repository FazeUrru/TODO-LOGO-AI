// Esquema PostgreSQL — gemelo 1:1 de prisma/schema.prisma (SQLite).
//
// v1.12.0: ELO global en serverless. Selecciona este esquema con
// DB_PROVIDER=postgres (el cliente Prisma y todo el código de la app son
// idénticos para ambos motores; solo cambia el datasource).
//
// Local:  bun run db:generate:pg / db:push:pg  (con DATABASE_URL apuntando a Postgres)
// Vercel: define DATABASE_URL (Neon / Vercel Postgres) + DB_PROVIDER=postgres;
//         scripts/vercel-build.mjs genera el cliente y sincroniza el esquema solo.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Voto de una batalla del arena: actualiza el ELO en vivo
model Vote {
  id        String   @id @default(cuid())
  battleId  String
  modelAId  String
  modelBId  String
  winner    String // 'A' | 'B' | 'tie' | 'bad'
  category  String   @default("global")
  createdAt DateTime @default(now())

  @@index([modelAId])
  @@index([modelBId])
  @@index([createdAt])
}

// ELO global persistente (v1.9.0) — con Postgres es global entre instancias.
model EloState {
  modelId   String   @id
  elo       Float    @default(1000)
  wins      Int      @default(0)
  losses    Int      @default(0)
  ties      Int      @default(0)
  battles   Int      @default(0)
  updatedAt DateTime @updatedAt

  @@index([elo])
}

// Ejecución guardada del Modo Agente
model AgentRun {
  id          String   @id @default(cuid())
  description String
  projectType String
  autonomy    String
  budget      String
  status      String   @default("planificado")
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

// Cuenta de usuario (correo o proveedor social)
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String? // null cuando la cuenta entra por proveedor social
  provider     String   @default("email") // email | google | github | microsoft | x
  createdAt    DateTime @default(now())

  // Perfil (v1.9.2) — 15 ajustes en 4 categorías, con autoguardado
  displayName    String? // Identidad
  username       String?
  bio            String?
  avatar         String? // emoji elegido
  accent         String? // id de la paleta
  pronouns       String? // Presencia
  location       String?
  website        String?
  focus          String? // área de IA favorita
  publicProfile  Boolean? // Privacidad
  showStats      Boolean?
  showTrophies   Boolean?
  weeklyDigest   Boolean? // Notificaciones
  newModelsAlert Boolean?
  arenaInvites   Boolean?
  profileAt      DateTime? // última escritura del perfil (resolución de conflictos)
}

// Campeón de una Copa Todólogo finalizada — Salón de la Fama (v1.12.0)
model CopaCampeon {
  id              String   @id @default(cuid())
  copaId          String   @unique
  prompt          String
  size            Int      @default(4)
  championModelId String
  championName    String
  runnerUpModelId String?
  runnerUpName    String?
  createdAt       DateTime @default(now())

  @@index([createdAt])
}

// Historial de cambios del perfil en la nube (v1.12.0)
model ProfileEvent {
  id      String   @id @default(cuid())
  userId  String
  campo   String
  detalle String   @default("")
  at      DateTime @default(now())

  @@index([userId, at])
}

// Sesión persistente de una Copa Todólogo (v1.13.0): el cuadro completo en
// JSON, con write-through en cada mutación y read-through al ausentarse de
// memoria — las copas sobreviven reinicios e instancias serverless.
model CopaSesion {
  id        String   @id // id de la copa (copa_xxx)
  size      Int      @default(4)
  datos     String // JSON canónico de la copa (src/lib/copas-persistir.ts)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([updatedAt])
}

// Canal Todólogo Labs (v1.14.0): features experimentales con ciclo de vida
// finito (máx. 8 semanas → graduación o descarte) y telemetría estructurada.
// El registro fuente de verdad vive en src/lib/labs.ts (viaja en el bundle);
// la tabla espejo permite estadísticas y, en el futuro, apagado en caliente.
model LabsFeature {
  id        String      @id // id canónico del registro, p. ej. "copa-32-64"
  nombre    String
  cohorte   String // "explorer" | "builder" | "inner"
  estado    String      @default("en-pruebas") // en-pruebas | graduado | descartado
  expira    DateTime?
  createdAt DateTime    @default(now())
  events    LabsEvent[]
}

// Evento de telemetría de Labs: adopción, uso, abandono o crash por feature.
model LabsEvent {
  id        String      @id @default(cuid())
  feature   LabsFeature @relation(fields: [featureId], references: [id])
  featureId String
  userId    String      @default("anon")
  tipo      String // "entered" | "used" | "abandoned" | "crashed"
  payload   String? // JSON opcional (detalles del crash, contexto…)
  createdAt DateTime @default(now())

  @@index([featureId, createdAt])
  @@index([tipo])
}
