# ── Base de datos SQLite (Prisma) ─────────────────────────────
# Local/Docker: ruta relativa al esquema en prisma/
DATABASE_URL="file:./db/custom.db"
# Vercel (serverless): /tmp es lo único escribible. OJO: efímero por
# instancia; la app crea el esquema sola al arrancar (instrumentation).
# DATABASE_URL="file:/tmp/todologo.db"

# ── Sesiones ──────────────────────────────────────────────────
# Secreto para firmar las cookies de sesión (obligatorio en producción)
# AUTH_SECRET="un-secreto-largo-y-aleatorio"

# ── OAuth 2.0 nativo (opcional; activa el consentimiento real) ──
# Google: https://console.cloud.google.com/apis/credentials
#   URI de retorno: {origin}/api/auth/oauth/google/callback
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GitHub: https://github.com/settings/developers
#   URI de retorno: {origin}/api/auth/oauth/github/callback
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""

# ── SDK de IA (z-ai-web-dev-sdk) ──────────────────────────────
# Las credenciales se resuelven en el entorno de ejecución; en
# despliegues propios define las variables que el SDK requiera.
# Sin credenciales, las batallas usan las plantillas de emergencia
# locales y la respuesta se marca con usedFallback: true.
